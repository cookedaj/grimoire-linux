#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# GameL in its own window:          grimoire-gamel
# from a terminal:                  grimoire-gamel list|status|play <launcher:id>
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
case "${1:-}" in
    list|status|play) exec python3 -m grimoire.spells.gamel "$@" ;;
esac
exec python3 -m grimoire.standalone gamel
