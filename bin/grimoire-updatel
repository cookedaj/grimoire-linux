#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# UpdateL in its own window:        grimoire-updatel
# the update check (the timer):     grimoire-updatel check [--notify]|enable|disable|status
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
case "${1:-}" in
    check|enable|disable|status) exec python3 -m grimoire.spells.updatel.daily "$@" ;;
esac
exec python3 -m grimoire.standalone updatel
