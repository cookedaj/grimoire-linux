#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# NoteL, Grimoire's notes and text editor:
#   grimoire-notel [file …]     open a window (or new tabs in the open one)
#   grimoire-notel --daily      today's note
#   grimoire-notel status       the home page's status line
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
exec python3 -m grimoire.spells.notel "$@"
