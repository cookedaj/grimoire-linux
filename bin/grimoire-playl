#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# PlayL, Grimoire's video and music player:
#   grimoire-playl [file|folder|playlist|URL ...]     play them (in the open PlayL window when there is one)
#   grimoire-playl --enqueue file ...                 add them to its queue
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONSAFEPATH=1       # never import a grimoire/ folder from the current directory instead
exec python3 -m grimoire.spells.playl "$@"
